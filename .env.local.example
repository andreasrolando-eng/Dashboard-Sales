# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API) after `supabase link`.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Dev-only: serve fixture data (and bypass auth) instead of querying a real
# Supabase project, so the UI can be run/checked without one. Has no effect
# unless NODE_ENV !== "production" as well -- see src/lib/mock/is-mock.ts.
# Leave unset (or false) once a real Supabase project is linked.
NEXT_PUBLIC_USE_MOCK_DATA=false

# Google SSO domain gate, checked server-side in src/app/auth/callback/route.ts.
# Leaving this unset means NO domain restriction (any Google account that also
# passes the allowed_users table check can sign in) -- always set this.
ALLOWED_EMAIL_DOMAIN=esb.co.id
