# Session pooler connection string for the mcp_analytics Postgres role.
# Get this from Supabase Dashboard -> Connect -> Session pooler, then swap
# in the mcp_analytics username/password (see mcp-server/README.md for the
# exact steps -- the role has to be created by a migration first).
# Format: postgresql://mcp_analytics.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=

# Optional -- Streamable HTTP transport (ChatGPT via Secure MCP Tunnel).
# Defaults shown; the server never binds beyond localhost.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3001
